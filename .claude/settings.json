{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git init)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(git clone --depth 50 *)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(taskkill /PID *)",
      "Bash(taskkill /F /PID *)",
      "Bash(npm audit)",
      "Bash(npm audit --json)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx playwright test)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright install chromium)",
      "Bash(pnpm exec playwright test)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm exec playwright install chromium)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(python -m pytest *)",
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(ruff *)",
      "Bash(pip-audit)",
      "Bash(pip-audit -r *)",
      "WebSearch",
      "Read(~/.claude/skills/**)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(taskkill /IM *)",
      "Bash(taskkill /im *)",
      "Bash(taskkill /F /IM *)",
      "Bash(taskkill /f /im *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(Stop-Process *)",
      "Edit(./.claude/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/settings.json)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(pnpm add -g *)",
      "Bash(pnpm install -g *)",
      "Bash(pnpm i -g *)",
      "Bash(npm audit fix)",
      "Bash(npm audit fix *)",
      "Bash(pip-audit --fix)",
      "Bash(pip-audit --fix *)",
      "Bash(pip-audit * --fix)",
      "Bash(pip-audit * --fix *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "frontend-dev|backend-dev",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git init)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(git clone --depth 50 *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run test)",
      "Bash(pnpm run build)",
      "Bash(pnpm run dev)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(taskkill /PID *)",
      "Bash(taskkill /F /PID *)",
      "Bash(npm audit)",
      "Bash(npm audit --json)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx playwright test)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright install chromium)",
      "Bash(pnpm exec playwright test)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm exec playwright install chromium)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(python -m pytest *)",
      "Bash(uv sync)",
      "Bash(ruff *)",
      "Bash(pip-audit)",
      "Bash(pip-audit -r *)",
      "WebSearch",
      "Read(~/.claude/skills/**)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(taskkill /IM *)",
      "Bash(taskkill /im *)",
      "Bash(taskkill /F /IM *)",
      "Bash(taskkill /f /im *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(Stop-Process *)",
      "Edit(./.claude/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/settings.json)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(pnpm add -g *)",
      "Bash(pnpm install -g *)",
      "Bash(pnpm i -g *)",
      "Bash(npm audit fix)",
      "Bash(npm audit fix *)",
      "Bash(pip-audit --fix)",
      "Bash(pip-audit --fix *)",
      "Bash(pip-audit * --fix)",
      "Bash(pip-audit * --fix *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/verify.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "frontend-dev|backend-dev|task-executor",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/verify.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}

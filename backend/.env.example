# backend-ის ლოკალური .env.example
# გადააკოპირე backend/.env-ში:  Copy-Item .env.example .env
# (ან გამოიყენე root-ის .env — config.py ორივეს კითხულობს)

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

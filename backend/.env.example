# backend-ის ლოკალური .env.example
# გადააკოპირე backend/.env-ში:  Copy-Item .env.example .env
# (ან გამოიყენე root-ის .env — config.py ორივეს კითხულობს)

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here
# ძველი SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY fallback-ად მუშაობს; ახალი სახელი იგებს.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS: dev-ში "*", production-ში მხოლოდ შენი დომენი (მძიმით გამოყოფილი)
CORS_ORIGINS=*

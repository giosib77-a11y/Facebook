# ==========================================================================
# root .env.example — გადააკოპირე .env-ში და შეავსე რეალური მნიშვნელობებით
#   cp .env.example .env   (ან PowerShell: Copy-Item .env.example .env)
# .env ფაილი არასდროს ჩააქოს git-ში (იხ. .gitignore).
# ==========================================================================

# ---- Supabase ----
# Project Settings -> API გვერდიდან Supabase dashboard-ში
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# publishable key (sb_publishable_...) — საჯარო; იგივე მნიშვნელობა frontend/public/config.js-ში
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# secret key (sb_secret_...) — სერვერის მხარეს ბოტისთვის (RLS-ს გვერდს უვლის). არასდროს front-ში!
SUPABASE_SECRET_KEY=sb_secret_your-key-here
# ძველი სახელები SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY ჯერ fallback-ად მუშაობს
# (თუ ახალი სახელიც დაყენებულია, ახალი იგებს).

# ---- App ----
# production-ზე ატვირთვისას: APP_ENV=production (ჩართავს HTTPS-headers-ს,
# დამალავს ტექნიკურ შეცდომებს, გამორთავს dev endpoint-ს /test-chat)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- CORS ----
# ვინ შეიძლება მიმართოს API-ს ბრაუზერიდან. dev-ში "*" (ყველა).
# production-ში მიუთითე მხოლოდ შენი დომენ(ებ)ი, მძიმით: https://shendomen.ge,https://www.shendomen.ge
CORS_ORIGINS=*

# ---- LLM (ბოტი) ----
# რომელი provider: claude (default) | openai. არასწორი მნიშვნელობა → სერვერი არ ადგება.
LLM_PROVIDER=claude
# Claude: Anthropic Console -> API Keys (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# OpenAI (მხოლოდ LLM_PROVIDER=openai-ზე): OpenAI Platform -> API keys (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# ერთი LLM მცდელობის timeout წამებში (>0 და ≤20; ყველა retry-ს ჯამი ≤45 წმ)
LLM_TIMEOUT_SECONDS=20
# არჩეული provider-ის key-ის გარეშე ბოტი გამორთულია (ოპერატორის პასუხს აგზავნის, ლოგში WARNING),
# დანარჩენი პანელი მუშაობს.

# ---- Facebook Messenger (ნაბიჯი 5) ----
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=choose-any-secret-string
FB_GRAPH_VERSION=v21.0
FB_REDIRECT_URI=https://YOUR-NGROK.ngrok-free.app/facebook/connect/callback
FRONTEND_URL=http://localhost:5500
# დააგენერირე: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FB_TOKEN_ENCRYPTION_KEY=
# საჯარო base URL (ცარიელი → FB_REDIRECT_URI-ის დომენიდან გამოითვლება). მაგ. ngrok https.
PUBLIC_BASE_URL=

# ---- Production (აუცილებელი / რეკომენდებული) ----
# ⚠️ production-ში სავალდებულოა (APP_ENV=production, სხვაგვარად სერვერი არ ადგება).
# კლიენტის IP = X-Forwarded-For-ის მარჯვნიდან N-ური ჩანაწერი. Render-ზე N=3
# (დადასტურებულია CLIENT_IP_DEBUG=true-ით; არასწორი N IP-ლიმიტებს აფუჭებს).
CLIENT_IP_TRUSTED_HOPS=1
# დროებითი diagnostic (ლოგში XFF/არჩეული IP) — N-ის დასადგენად, მერე გამორთე
CLIENT_IP_DEBUG=false
# ლოგის დონე (INFO | WARNING | DEBUG)
LOG_LEVEL=INFO
# ---- Stage 20 — შეტყობინებები / LLM ბიუჯეტი ----
# Email (SMTP): ნებისმიერი provider, მაგ. Brevo smtp-relay.brevo.com:587 ან Resend SMTP smtp.resend.com:465.
# პორტი 465 = SSL, სხვა (587) = STARTTLS. NOTIFY_EMAIL_FROM-ის დომენი provider-ში ვერიფიცირებული უნდა იყოს.
# ოთხივე (HOST, USER, PASSWORD, FROM) ცარიელი ან ერთი მაინც ცარიელი = email არხი გამორთულია.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# მაგ.: ChatAssist <noreply@chatassist.ge>
NOTIFY_EMAIL_FROM=
# Telegram: ბოტის token (@BotFather) და chat id. ორივე ცარიელი = Telegram არხი გამორთულია.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# LLM kill-switch: true → ყველა tenant-ის ბოტი LLM-ის გარეშე (ოპერატორის პასუხი)
LLM_KILL_SWITCH=false
# გლობალური დღიური ტოკენ-ჭერი (ყველა tenant ერთად). 0 = ჭერი გამორთულია
LLM_DAILY_TOKEN_CAP=3000000
# თვიური ტოკენ-ბიუჯეტი პაკეტის მიხედვით (მაღაზიაზე). 0 = ჭერი გამორთულია
LLM_MONTHLY_TOKENS_FREE=2000000
LLM_MONTHLY_TOKENS_BASIC=12000000
LLM_MONTHLY_TOKENS_STANDARD=48000000
LLM_MONTHLY_TOKENS_BUSINESS=180000000
# ადმინ-პანელი: Supabase user UUID-ები (Authentication -> Users), მძიმით. ცარიელი = ადმინი არავინაა.
ADMIN_USER_IDS=
# გადახდის რეკვიზიტები (გამყიდველი პაკეტის მოთხოვნისას ხედავს). არ დააყენო = placeholder ჩანს.
PAYMENT_IBAN=
PAYMENT_CONTACT=
